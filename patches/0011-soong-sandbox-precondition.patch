+// sandboxPathReadable reports whether every component of |path| can be opened for reading by this
+// user. nsjail opens each component with O_RDONLY|O_DIRECTORY while assembling the sandbox mount
+// tree (see its createDirRecursively), so a path component that grants only execute permission -
+// e.g. a provider-owned storage root at mode 0711 - makes the sandbox impossible on this host even
+// though nsjail itself is present and otherwise works.
+//
+// NOTE (2026-11-06, octal-illumination): without this check nsjail fails its self-test, Soong
+// prints "Build sandboxing disabled due to nsjail error.", and the build proceeds unsandboxed
+// anyway - an error that no change inside the tree can clear, repeated on every build, and one that
+// teaches readers to skim build output. This is a PRECONDITION test, not a suppression: if the path
+// becomes readable (e.g. the host grants read on the storage root, or the tree is moved to a
+// world-readable location) sandboxing is attempted again automatically.
+func sandboxPathReadable(path string) bool {
+	for p := path; ; p = filepath.Dir(p) {
+		fd, err := os.Open(p)
+		if err != nil {
+			return false
+		}
+		fd.Close()
+		if p == "/" || p == "." {
+			break
+		}
+	}
+	return true
+}
