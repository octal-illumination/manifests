+def DoesInputFileContainPartition(input_file, partition):
+  """Check whether |partition| (e.g. SYSTEM) is a top-level entry of the input.
+
+  Used to tell "this device does not have that partition" (normal) apart from "the partition is
+  here but its build.prop is missing" (an anomaly worth a warning).
+  """
+  if isinstance(input_file, zipfile.ZipFile):
+    names = input_file.namelist()
+  elif zipfile.is_zipfile(input_file):
+    with zipfile.ZipFile(input_file, "r", allowZip64=True) as zfp:
+      names = zfp.namelist()
+  else:
+    return os.path.isdir(os.path.join(input_file, partition))
+  prefix = partition + '/'
+  return any(n.startswith(prefix) for n in names)
+
